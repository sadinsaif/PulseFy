# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public base URL of the app (Vercel sets this automatically in prod;
# use http://localhost:3000 for local dev)
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# --- Vercel Postgres ---
# These are set automatically when you add Vercel Postgres storage.
# For local dev, copy them from the Vercel dashboard (Storage > .env.local tab).
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# --- Admin ---
# Only these emails can review (approve/reject) creator submissions.
# Comma-separated for multiple admins.
ADMIN_EMAIL=yasin.arafat.sadin@gmail.com

# --- Email verification ---
# Leave unset (or "false") to activate accounts immediately on signup —
# recommended until you set RESEND_API_KEY and (to reach anyone but your own
# Resend account email) verify a custom sending domain, because the default
# onboarding@resend.dev sender only delivers to your own address. Set to
# "true" to email a 6-digit code that must be entered before an account can
# sign in.
REQUIRE_EMAIL_VERIFICATION=false

# --- Resend (email) ---
# Get a free key at https://resend.com
RESEND_API_KEY=
# Until you verify a custom domain, use: onboarding@resend.dev
EMAIL_FROM="PulseFy <onboarding@resend.dev>"

# --- YouTube metrics (auto-fetch views/likes/comments) ---
# FREE, no billing. Create a project at https://console.cloud.google.com,
# enable "YouTube Data API v3", make an API key, and paste it here.
# Server-only — do NOT prefix with NEXT_PUBLIC_. When set, YouTube/Shorts
# submissions auto-fill real views + engagement. Leave blank to disable
# (other platforms stay "metrics pending" — we never fake numbers).
YOUTUBE_API_KEY=

# --- Privy auth (OPTIONAL — currently dormant, not wired into the UI) ---
# PulseFy ships a full Privy login bridge (wallet + email/Google OTP), but it is
# OFF by default: the client SDK is not mounted, so leaving these unset changes
# nothing. To activate later you must ALSO re-mount PrivyProvider and render the
# Privy buttons. Values come from the Privy dashboard (https://dashboard.privy.io).
# Public app id — safe to expose; the NEXT_PUBLIC_ prefix is intentional.
NEXT_PUBLIC_PRIVY_APP_ID=
# Server-only app secret — never prefix with NEXT_PUBLIC_ (must not reach the client).
PRIVY_APP_SECRET=
# Optional PEM ECDSA public key; when set, token checks skip a per-call JWKS fetch (perf only).
# PRIVY_VERIFICATION_KEY=

# ============================================================================
# $PULSE — Solana token + dApp (devnet first; mainnet is an env flip later)
# ============================================================================

# --- Network / RPC (client — NEXT_PUBLIC_ is intentional, these are public) ---
# network: "devnet" (default) | "mainnet-beta" | "testnet". Controls the explorer
# links and the default RPC when NEXT_PUBLIC_SOLANA_RPC is left blank.
NEXT_PUBLIC_SOLANA_NETWORK=devnet
# Override the RPC endpoint. Leave blank to use the public cluster URL for the
# network above. For mainnet, set a PAID RPC (Helius/QuickNode/Alchemy) — the
# public mainnet RPC is heavily rate-limited and unusable in production.
NEXT_PUBLIC_SOLANA_RPC=

# --- Token identity (client) ---
# Set NEXT_PUBLIC_TOKEN_MINT to the mint address printed by scripts/create-token.mjs.
# Until it is set, the dApp shows a "token not deployed yet" state (never fakes one).
NEXT_PUBLIC_TOKEN_MINT=
NEXT_PUBLIC_TOKEN_SYMBOL=PULSE
NEXT_PUBLIC_TOKEN_DECIMALS=9
# Public base URL (used for the token metadata URI). Falls back to NEXTAUTH_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Rewards (server) ---
# Hold-to-earn accrual rate in parts-per-million of the held balance, per day.
# e.g. 100 = 0.01%/day of held tokens accrue as rewards. Size this to the
# treasury runway before mainnet. Leave 0 to pause accrual.
TOKEN_REWARD_RATE_PPM=0
# Shared secret the accrual cron must send as `Authorization: Bearer <CRON_SECRET>`.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# --- Script-only (NEVER prefix NEXT_PUBLIC_, NEVER commit the files) ---
# Path to a local Solana keypair JSON (the Solana CLI format: a JSON array of
# bytes). SOLANA_KEYPAIR_PATH funds + authorities token creation; TREASURY_
# KEYPAIR_PATH signs reward payouts. Keep these in ./.keys/ (gitignored) or, for
# mainnet, on a hardware wallet / offline machine — the treasury key can move all
# reward funds.
SOLANA_KEYPAIR_PATH=./.keys/id.json
TREASURY_KEYPAIR_PATH=./.keys/treasury.json
